{
  "openapi": "3.1.0",
  "info": {
    "title": "ILC - API simulada de eventos",
    "version": "0.1.0"
  },
  "paths": {
    "/events": {
      "get": {
        "summary": "Get Events",
        "description": "Fixture valid/events.jsonl integral, sem deduplicacao. Ordem: source_system, event_id, posicao original. Snapshot fixo no inicio. Termino: next_cursor=null e has_more=false. Limite entre 1 e 100.",
        "operationId": "get_events_events_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 5,
              "title": "Limit"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 256
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "Cursor invalido ou de outro snapshot"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios/delay": {
      "get": {
        "tags": [
          "Falhas controladas"
        ],
        "summary": "Resposta atrasada; timeout depende do cliente",
        "operationId": "delay_scenarios_delay_get",
        "parameters": [
          {
            "name": "seconds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 2.0,
              "minimum": 0.1,
              "default": 1.0,
              "title": "Seconds"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scenarios/http-503": {
      "get": {
        "tags": [
          "Falhas controladas"
        ],
        "summary": "Http 503",
        "operationId": "http_503_scenarios_http_503_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "503": {
            "description": "Indisponibilidade HTTP simulada"
          }
        }
      }
    },
    "/scenarios/invalid-json": {
      "get": {
        "tags": [
          "Falhas controladas"
        ],
        "summary": "Invalid Json",
        "operationId": "invalid_json_scenarios_invalid_json_get",
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version"
          },
          "source_system": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$",
            "title": "Source System"
          },
          "event_id": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$",
            "title": "Event Id"
          },
          "delivery_id": {
            "type": "string",
            "pattern": "^\\S(?:.*\\S)?$",
            "title": "Delivery Id"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "DISPATCHED",
              "IN_TRANSIT",
              "DELIVERED"
            ],
            "title": "Event Type"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "schema_version",
          "source_system",
          "event_id",
          "delivery_id",
          "event_type",
          "occurred_at"
        ],
        "title": "Event"
      },
      "EventPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "dataset_id": {
            "type": "string",
            "title": "Dataset Id"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "dataset_id",
          "next_cursor",
          "has_more"
        ],
        "title": "EventPage"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
